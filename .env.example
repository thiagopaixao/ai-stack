# ai-stack secrets — example file.
#
# The REAL file lives at $AI_STACK_HOME/secrets.env (default: ~/ai-stack/secrets.env),
# must be chmod 600, and is NEVER committed. It is loaded automatically by
# platform/scripts/load-env.sh (set -a; . secrets.env; set +a).
#
#   cp .env.example ~/ai-stack/secrets.env && chmod 600 ~/ai-stack/secrets.env

# API key of the local 9router (optional provider, http://127.0.0.1:20128/v1).
# Referenced in opencode.json as "{env:NINEROUTER_API_KEY}".
NINEROUTER_API_KEY=

# Optional: Context7 MCP (higher rate limits)
CONTEXT7_API_KEY=

# Optional: Exa web search
EXA_API_KEY=
